@model Employee
@{
    ViewData["Title"] = "Employee Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <!-- Profile Banner -->
            <div class="bg-gradient p-4 text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);">
                <div class="d-flex flex-wrap align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="avatar-circle avatar-lg bg-white text-primary fw-bold me-3 shadow">
                            @Model.FirstName.Substring(0, 1).ToUpper()@Model.LastName.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">@Model.FullName</h3>
                            <span class="text-white-50">@Model.Designation</span>
                            <span class="badge bg-light text-dark rounded-pill ms-2 px-3 py-1">
                                @(Model.Department?.Name ?? "General")
                            </span>
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mt-3 mt-md-0">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-3 me-1 text-dark fw-bold">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-light rounded-pill px-3">
                                <i class="fas fa-trash me-1"></i> Delete
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted text-uppercase fw-semibold d-block">Work Email</small>
                            <span class="fw-bold text-dark"><i class="fas fa-envelope text-primary me-2"></i>@Model.Email</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted text-uppercase fw-semibold d-block">Phone Number</small>
                            <span class="fw-bold text-dark"><i class="fas fa-phone text-success me-2"></i>@Model.PhoneNumber</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted text-uppercase fw-semibold d-block">Hire Date</small>
                            <span class="fw-bold text-dark"><i class="fas fa-calendar-check text-info me-2"></i>@Model.HireDate.ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted text-uppercase fw-semibold d-block">Date of Birth</small>
                            <span class="fw-bold text-dark"><i class="fas fa-birthday-cake text-warning me-2"></i>@Model.DateOfBirth.ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted text-uppercase fw-semibold d-block">Department</small>
                            <span class="fw-bold text-dark"><i class="fas fa-building text-primary me-2"></i>@(Model.Department?.Name ?? "N/A")</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted text-uppercase fw-semibold d-block">Current Compensation</small>
                            <span class="fw-bold text-success fs-5">₹@Model.Salary.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <!-- Monthly Attendance & Leaves Summary -->
                <div class="mt-4 pt-4 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="far fa-calendar-alt text-primary me-2"></i>This Month's Attendance &amp; Leaves
                        </h5>
                        <a asp-action="MonthlyAttendance" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            View Full Attendance Calendar <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <small class="text-muted fw-bold d-block text-uppercase">Days Present</small>
                                <span class="fs-4 fw-bold text-success">@(ViewBag.DaysPresent ?? 0)</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <small class="text-muted fw-bold d-block text-uppercase">Approved Leaves</small>
                                <span class="fs-4 fw-bold text-info">@(ViewBag.DaysOnLeave ?? 0)</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <small class="text-muted fw-bold d-block text-uppercase">Late Arrivals</small>
                                <span class="fs-4 fw-bold text-warning">@(ViewBag.DaysLate ?? 0)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-arrow-left me-1"></i> Back to Employee Directory
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
