@model EmployeeMonthlyAttendanceViewModel
@{
    ViewData["Title"] = $"{Model.Employee.FullName} - Attendance & Leaves";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="far fa-calendar-alt text-primary me-2"></i>Monthly Attendance &amp; Leaves
        </h2>
        <p class="text-muted mb-0">Record for <strong>@Model.Employee.FullName</strong> &bull; @Model.MonthName</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to Employees
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fas fa-home me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- Employee Header Card -->
<div class="card border-0 rounded-4 p-4 mb-4 text-white shadow-sm" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%);">
    <div class="d-flex flex-wrap align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <div class="avatar-circle bg-white text-primary fw-bold me-3" style="width: 52px; height: 52px; font-size: 1.3rem;">
                @Model.Employee.FirstName.Substring(0, 1)@Model.Employee.LastName.Substring(0, 1)
            </div>
            <div>
                <h4 class="fw-bold mb-0">@Model.Employee.FullName</h4>
                <div class="text-white-50 small">@Model.Employee.Designation &bull; @(Model.Employee.Department?.Name ?? "General")</div>
            </div>
        </div>
        <div class="mt-3 mt-md-0 text-md-end">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                <i class="fas fa-calendar-check me-1"></i> @Model.MonthName
            </span>
        </div>
    </div>
</div>

<!-- Monthly Summary Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Days Present</small>
                    <div class="dash-stat-number text-success mb-0" style="font-size: 2rem;">@Model.DaysPresent</div>
                </div>
                <div class="dash-icon-box bg-success bg-opacity-10 text-success">
                    <i class="fas fa-user-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Leaves Taken</small>
                    <div class="dash-stat-number text-info mb-0" style="font-size: 2rem;">@Model.DaysOnLeave</div>
                </div>
                <div class="dash-icon-box bg-info bg-opacity-10 text-info">
                    <i class="fas fa-umbrella-beach"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Late Days</small>
                    <div class="dash-stat-number text-warning mb-0" style="font-size: 2rem;">@Model.DaysLate</div>
                </div>
                <div class="dash-icon-box bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Available Leaves</small>
                    <div class="dash-stat-number text-primary mb-0" style="font-size: 2rem;">@Model.AvailableLeaveBalance</div>
                </div>
                <div class="dash-icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-calendar-plus"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Daily Log Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="fas fa-calendar-day text-primary me-2"></i>Day-by-Day Log for @Model.MonthName
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Day</th>
                        <th>Clock In</th>
                        <th>Clock Out</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@record.Date.ToString("dd MMMM yyyy")</td>
                            <td><span class="badge bg-light text-dark border px-2 py-1">@record.Date.ToString("dddd")</span></td>
                            <td>
                                @(record.ClockIn.HasValue ? DateTime.Today.Add(record.ClockIn.Value).ToString("hh:mm tt") : "--:--")
                            </td>
                            <td>
                                @(record.ClockOut.HasValue ? DateTime.Today.Add(record.ClockOut.Value).ToString("hh:mm tt") : "--:--")
                            </td>
                            <td>
                                @if (record.Status == "Present")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        <i class="fas fa-check-circle me-1"></i> Present
                                    </span>
                                }
                                else if (record.Status == "Late")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                                        <i class="fas fa-clock me-1"></i> Late Check-in
                                    </span>
                                }
                                else if (record.Status == "On Leave")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">
                                        <i class="fas fa-umbrella-beach me-1"></i> On Leave
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                        <i class="fas fa-times-circle me-1"></i> Absent
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(record.Remarks ?? "Normal attendance recorded")</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

