@model IEnumerable<Department>
@{
    ViewData["Title"] = "Department Management";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="fas fa-building text-success me-2"></i>Departments Management
        </h2>
        <p class="text-muted mb-0">Manage organizational business units, operational teams, and departmental roles.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> Return to Dashboard
        </a>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>Add New Department
        </a>
    </div>
</div>

<div class="row g-4">
    @foreach (var dept in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 card-hover rounded-4">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-building"></i>
                        </div>
                        <span class="badge bg-light text-muted border px-2 py-1 small">ID #@dept.Id</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">@dept.Name</h5>
                    <p class="text-muted small flex-grow-1">
                        @(string.IsNullOrEmpty(dept.Description) ? "No detailed description provided." : dept.Description)
                    </p>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Actions</span>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-outline-warning rounded-pill px-3 me-1">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@dept.Id" class="btn btn-outline-danger rounded-pill px-3">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
