@model Department
@{
    ViewData["Title"] = "Create Department";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-success text-white py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-white bg-opacity-20 text-white me-3" style="width: 42px; height: 42px;">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">Add Department</h4>
                        <small class="text-white-50">Create an organizational unit</small>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                    <i class="fas fa-arrow-left me-1"></i> Return
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Engineering, Sales, QA" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label small fw-semibold text-muted"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief outline of departmental operations..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                            <i class="fas fa-save me-1"></i> Save Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
