@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Header (Without the extra buttons) -->
<div class="mb-4">
    <h1 class="dashboard-heading mb-1">Dashboard</h1>
    <p class="text-muted small mb-0">Welcome back! Real-time workforce metrics, departmental operations, and activity overview.</p>
</div>

<!-- 4 Stat Cards matching reference image with 100% REAL database data -->
<div class="row g-4 mb-4">
    <!-- Card 1: Total Employees -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Employee" asp-action="Index" class="text-decoration-none">
            <div class="dash-card">
                <div>
                    <div class="card-top-row">
                        <div class="dash-icon-box" style="background-color: var(--accent-purple-light); color: var(--accent-purple);">
                            <i class="fas fa-users"></i>
                        </div>
                        <h6 class="dash-card-title">Total Employees</h6>
                    </div>
                    <div class="dash-stat-number">@Model.TotalEmployees</div>
                    <div class="d-flex align-items-center flex-wrap">
                        <span class="stat-pill-badge pill-green">
                            <i class="fas fa-check me-1"></i> Active
                        </span>
                        <span class="pill-subtext">Across @Model.TotalDepartments Departments</span>
                    </div>
                </div>

                <!-- Mini Bar Graphic on right as in image -->
                <div class="mini-bars-graphic">
                    <div class="mini-bar light" style="height: 18px;"></div>
                    <div class="mini-bar med" style="height: 30px;"></div>
                    <div class="mini-bar high" style="height: 52px;"></div>
                    <div class="mini-bar med" style="height: 38px;"></div>
                    <div class="mini-bar light" style="height: 24px;"></div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 2: Departments -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Department" asp-action="Index" class="text-decoration-none">
            <div class="dash-card">
                <div>
                    <div class="card-top-row">
                        <div class="dash-icon-box" style="background-color: var(--accent-green-light); color: var(--accent-green);">
                            <i class="fas fa-building"></i>
                        </div>
                        <h6 class="dash-card-title">Departments</h6>
                    </div>
                    <div class="dash-stat-number">@Model.TotalDepartments</div>
                    <div class="d-flex align-items-center flex-wrap">
                        <span class="stat-pill-badge pill-green">
                            <i class="fas fa-layer-group me-1"></i> Organized
                        </span>
                        <span class="pill-subtext">IT, HR, Finance, Mktg</span>
                    </div>
                </div>

                <div class="mini-bars-graphic">
                    <div class="mini-bar light" style="height: 22px;"></div>
                    <div class="mini-bar med" style="height: 35px;"></div>
                    <div class="mini-bar high" style="height: 56px;"></div>
                    <div class="mini-bar light" style="height: 28px;"></div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 3: Present Today -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Attendance" asp-action="Index" class="text-decoration-none">
            <div class="dash-card">
                <div>
                    <div class="card-top-row">
                        <div class="dash-icon-box" style="background-color: var(--accent-orange-light); color: var(--accent-orange);">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <h6 class="dash-card-title">Present Today</h6>
                    </div>
                    <div class="dash-stat-number">@Model.PresentToday</div>
                    <div class="d-flex align-items-center flex-wrap">
                        <span class="stat-pill-badge pill-green">
                            <i class="fas fa-arrow-up me-1"></i> @(Model.TotalEmployees > 0 ? (Model.PresentToday * 100 / Model.TotalEmployees) : 0)%
                        </span>
                        <span class="pill-subtext">Daily Attendance Rate</span>
                    </div>
                </div>

                <div class="mini-bars-graphic">
                    <div class="mini-bar light" style="height: 15px;"></div>
                    <div class="mini-bar med" style="height: 26px;"></div>
                    <div class="mini-bar high" style="height: 48px;"></div>
                    <div class="mini-bar light" style="height: 20px;"></div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 4: Available Leaves -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Attendance" asp-action="Index" class="text-decoration-none">
            <div class="dash-card">
                <div>
                    <div class="card-top-row">
                        <div class="dash-icon-box" style="background-color: var(--accent-blue-light); color: var(--accent-blue);">
                            <i class="fas fa-umbrella-beach"></i>
                        </div>
                        <h6 class="dash-card-title">Available Leaves</h6>
                    </div>
                    <div class="dash-stat-number">@Model.AvailableLeaves</div>
                    <div class="d-flex align-items-center flex-wrap">
                        <span class="stat-pill-badge @(Model.OnLeaveToday > 0 ? "pill-green" : "pill-red")">
                            <i class="fas fa-user-clock me-1"></i> @Model.OnLeaveToday
                        </span>
                        <span class="pill-subtext">Staff On Leave Today</span>
                    </div>
                </div>

                <div class="mini-bars-graphic">
                    <div class="mini-bar light" style="height: 20px;"></div>
                    <div class="mini-bar med" style="height: 32px;"></div>
                    <div class="mini-bar high" style="height: 50px;"></div>
                    <div class="mini-bar light" style="height: 22px;"></div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Weekly Working Hours Chart Card matching image -->
<div class="chart-card mb-4">
    <div class="chart-header">
        <h5 class="chart-title">Weekly working Hours</h5>
        <div class="chart-legends">
            <div><span class="legend-dot dot-break"></span> Break Hours</div>
            <div><span class="legend-dot dot-work"></span> Work Hours</div>
        </div>
    </div>
    <div style="height: 250px; position: relative;">
        <canvas id="weeklyHoursChart"></canvas>
    </div>
</div>

<!-- Bottom Section: Recent Employees & Upcoming Holidays -->
<div class="row g-4">
    <!-- Recent Employees Table -->
    <div class="col-lg-7">
        <div class="chart-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="fas fa-users text-primary me-2"></i>Recent Workforce Directory
                </h6>
                <a asp-controller="Employee" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">
                    View All (@Model.TotalEmployees) <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Department</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.RecentEmployees)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Employee" asp-action="MonthlyAttendance" asp-route-id="@emp.Id" class="text-decoration-none d-flex align-items-center" title="Click to view @emp.FullName's attendance & leaves">
                                        <div class="avatar-circle me-2 bg-primary bg-opacity-10 text-primary fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @emp.FirstName.Substring(0, 1)@emp.LastName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">@emp.FullName</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">@emp.Email</small>
                                        </div>
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                        @(emp.Department?.Name ?? "General")
                                    </span>
                                </td>
                                <td>
                                    <small class="fw-medium text-dark">@emp.Designation</small>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Employee" asp-action="MonthlyAttendance" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 small" title="Attendance History">
                                        <i class="far fa-calendar-check me-1"></i> Attendance
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Upcoming Holidays Preview -->
    <div class="col-lg-5">
        <div class="chart-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="fas fa-calendar-alt text-warning me-2"></i>Upcoming Holidays
                </h6>
                <a asp-controller="Holiday" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">
                    View Calendar <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>
            <div class="d-flex flex-column gap-3">
                @foreach (var h in Model.UpcomingHolidays)
                {
                    <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3" style="width: 38px; height: 38px; font-size: 1rem;">
                                <i class="fas fa-sun"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">@h.Name</div>
                                <small class="text-muted" style="font-size: 0.75rem;">@h.Type</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-primary small">@h.Date.ToString("dd MMM yyyy")</div>
                            <small class="text-muted" style="font-size: 0.7rem;">@h.DayOfWeek</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('weeklyHoursChart').getContext('2d');
            
            const workGradient = ctx.createLinearGradient(0, 0, 0, 250);
            workGradient.addColorStop(0, 'rgba(245, 158, 11, 0.35)');
            workGradient.addColorStop(1, 'rgba(245, 158, 11, 0.02)');

            const breakGradient = ctx.createLinearGradient(0, 0, 0, 250);
            breakGradient.addColorStop(0, 'rgba(209, 213, 219, 0.4)');
            breakGradient.addColorStop(1, 'rgba(209, 213, 219, 0.02)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [
                        {
                            label: 'Work Hours',
                            data: [7.5, 8.2, 8.0, 9.1, 7.8, 4.0, 2.5],
                            borderColor: '#f59e0b',
                            backgroundColor: workGradient,
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.45,
                            pointBackgroundColor: '#f59e0b',
                            pointRadius: 4,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'Break Hours',
                            data: [1.2, 1.0, 1.5, 1.1, 1.3, 0.5, 0.2],
                            borderColor: '#9ca3af',
                            backgroundColor: breakGradient,
                            borderWidth: 2,
                            fill: true,
                            tension: 0.45,
                            pointBackgroundColor: '#9ca3af',
                            pointRadius: 3,
                            pointHoverRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af', font: { family: 'Plus Jakarta Sans', weight: '600' } }
                        },
                        y: {
                            grid: { color: '#f3f4f6' },
                            ticks: { color: '#9ca3af', font: { family: 'Plus Jakarta Sans' }, stepSize: 2 }
                        }
                    }
                }
            });
        });
    </script>
}
