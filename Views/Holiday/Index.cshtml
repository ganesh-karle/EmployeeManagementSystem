@model IEnumerable<Holiday>
@{
    ViewData["Title"] = "Holidays Calendar";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="fas fa-umbrella-beach text-warning me-2"></i>Official Holidays Calendar
        </h2>
        <p class="text-muted mb-0">List of public, festive, and mandatory company leaves scheduled for the organization.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> Return to Dashboard
        </a>
        @if (User.IsInRole("Admin"))
        {
            <button type="button" class="btn btn-dark rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
                <i class="fas fa-plus me-1"></i> Add Holiday
            </button>
        }
    </div>
</div>

<!-- Next Upcoming Holiday Highlight Card -->
@{
    var nextHoliday = Model.Where(h => h.Date >= DateTime.Today).OrderBy(h => h.Date).FirstOrDefault();
}
@if (nextHoliday != null)
{
    var daysUntil = (nextHoliday.Date - DateTime.Today).Days;
    <div class="card border-0 rounded-4 p-4 text-white mb-4 shadow-sm" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%);">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-white bg-opacity-20 text-warning me-3" style="width: 54px; height: 54px; font-size: 1.6rem;">
                    <i class="fas fa-calendar-star"></i>
                </div>
                <div>
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-2 fw-bold">Next Upcoming Holiday</span>
                    <h3 class="fw-bold mb-1">@nextHoliday.Name</h3>
                    <p class="text-white-50 mb-0 small">@nextHoliday.Description</p>
                </div>
            </div>
            <div class="mt-3 mt-md-0 text-md-end">
                <div class="fs-4 fw-extrabold text-warning">@nextHoliday.Date.ToString("dd MMMM yyyy")</div>
                <span class="badge bg-white bg-opacity-15 text-white rounded-pill px-3 py-1">
                    @(daysUntil == 0 ? "Today!" : $"In {daysUntil} days ({nextHoliday.DayOfWeek})")
                </span>
            </div>
        </div>
    </div>
}

<!-- Holidays Grid / List -->
<div class="row g-4">
    @foreach (var holiday in Model)
    {
        var isPassed = holiday.Date < DateTime.Today;
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 card-hover overflow-hidden @(isPassed ? "opacity-75" : "")">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge bg-light text-muted border px-2 py-1 small">
                                <i class="fas fa-tag me-1"></i> @holiday.Type
                            </span>
                            @if (!isPassed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                    Upcoming
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1 small">
                                    Completed
                                </span>
                            }
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@holiday.Name</h5>
                        <p class="text-muted small mb-3">@holiday.Description</p>
                    </div>

                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-primary">@holiday.Date.ToString("dd MMM yyyy")</div>
                            <small class="text-muted">@holiday.DayOfWeek</small>
                        </div>
                        <div class="stat-icon bg-light text-primary" style="width: 38px; height: 38px; font-size: 1rem;">
                            <i class="far fa-calendar-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal for Admin to Add Holiday -->
@if (User.IsInRole("Admin"))
{
    <div class="modal fade" id="addHolidayModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold"><i class="fas fa-calendar-plus text-primary me-2"></i>Add New Holiday</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Holiday Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Diwali, Independence Day" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Date</label>
                            <input type="date" name="Date" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Category / Type</label>
                            <select name="Type" class="form-select">
                                <option value="Public Holiday">Public Holiday</option>
                                <option value="National Holiday">National Holiday</option>
                                <option value="Festive Holiday">Festive Holiday</option>
                                <option value="Company Mandatory">Company Mandatory</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Description</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Brief note about the holiday"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top py-2 px-4">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">Save Holiday</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

