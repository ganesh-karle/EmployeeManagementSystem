@model IEnumerable<AttendanceRecord>
@{
    ViewData["Title"] = "Workforce Attendance";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="far fa-calendar-check text-primary me-2"></i>Daily Attendance &amp; Leaves
        </h2>
        <p class="text-muted mb-0">Monitor daily workforce check-ins, punctuality, and approved leaves.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2 align-items-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> Return to Dashboard
        </a>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="date" name="date" value="@(((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-pill shadow-sm" onchange="this.form.submit()" />
            <select name="status" class="form-select form-select-sm rounded-pill shadow-sm" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                <option value="Present" selected="@(ViewBag.SelectedStatus == "Present")">Present</option>
                <option value="Late" selected="@(ViewBag.SelectedStatus == "Late")">Late</option>
                <option value="On Leave" selected="@(ViewBag.SelectedStatus == "On Leave")">On Leave</option>
                <option value="Absent" selected="@(ViewBag.SelectedStatus == "Absent")">Absent</option>
            </select>
        </form>
    </div>
</div>

<!-- Attendance Overview Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Present Today</small>
                    <div class="dash-stat-number text-success mb-0" style="font-size: 1.8rem;">@ViewBag.TotalPresent</div>
                </div>
                <div class="dash-icon-box bg-success bg-opacity-10 text-success">
                    <i class="fas fa-user-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Late Check-in</small>
                    <div class="dash-stat-number text-warning mb-0" style="font-size: 1.8rem;">@ViewBag.TotalLate</div>
                </div>
                <div class="dash-icon-box bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">On Leave</small>
                    <div class="dash-stat-number text-info mb-0" style="font-size: 1.8rem;">@ViewBag.TotalLeave</div>
                </div>
                <div class="dash-icon-box bg-info bg-opacity-10 text-info">
                    <i class="fas fa-umbrella-beach"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dash-card p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-bold text-uppercase">Absent</small>
                    <div class="dash-stat-number text-danger mb-0" style="font-size: 1.8rem;">@ViewBag.TotalAbsent</div>
                </div>
                <div class="dash-icon-box bg-danger bg-opacity-10 text-danger">
                    <i class="fas fa-user-times"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Roster Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="fas fa-list-check text-primary me-2"></i>Attendance Log for @(((DateTime)ViewBag.SelectedDate).ToString("dd MMMM yyyy"))
        </h5>
        <span class="badge bg-light text-muted border px-3 py-2">@Model.Count() Logged Staff</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Department</th>
                        <th>Clock In</th>
                        <th>Clock Out</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end pe-4">Update Status</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr style="cursor: pointer;" onclick="showAttendanceModal(@record.EmployeeId)">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3 bg-primary bg-opacity-10 text-primary fw-bold" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                        @(record.Employee?.FirstName.Substring(0, 1) ?? "E")@(record.Employee?.LastName.Substring(0, 1) ?? "")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark text-hover-primary">@record.Employee?.FullName</div>
                                        <small class="text-muted">@record.Employee?.Designation</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                    @(record.Employee?.Department?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">
                                    <i class="far fa-clock text-muted me-1 small"></i>
                                    @(record.ClockIn.HasValue ? DateTime.Today.Add(record.ClockIn.Value).ToString("hh:mm tt") : "--:--")
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold text-muted">
                                    @(record.ClockOut.HasValue ? DateTime.Today.Add(record.ClockOut.Value).ToString("hh:mm tt") : "--:--")
                                </span>
                            </td>
                            <td>
                                @if (record.Status == "Present")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        <i class="fas fa-check-circle me-1"></i> Present
                                    </span>
                                }
                                else if (record.Status == "Late")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                                        <i class="fas fa-clock me-1"></i> Late
                                    </span>
                                }
                                else if (record.Status == "On Leave")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">
                                        <i class="fas fa-umbrella-beach me-1"></i> On Leave
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                        <i class="fas fa-times-circle me-1"></i> Absent
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(record.Remarks ?? "Standard attendance recorded.")</small>
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-end pe-4" onclick="event.stopPropagation()">
                                    <form asp-action="Mark" method="post" class="d-inline-flex gap-1 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="employeeId" value="@record.EmployeeId" />
                                        <select name="status" class="form-select form-select-sm rounded-pill" style="width: 120px;" onchange="this.form.submit()">
                                            <option value="Present" selected="@(record.Status == "Present")">Present</option>
                                            <option value="Late" selected="@(record.Status == "Late")">Late</option>
                                            <option value="On Leave" selected="@(record.Status == "On Leave")">On Leave</option>
                                            <option value="Absent" selected="@(record.Status == "Absent")">Absent</option>
                                        </select>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

