@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="p-4 text-center bg-gradient text-white" style="background: linear-gradient(135deg, #065f46 0%, #059669 100%);">
                <div class="bg-white bg-opacity-15 p-3 rounded-circle d-inline-flex mb-2">
                    <i class="fas fa-user-plus fa-2x text-white"></i>
                </div>
                <h4 class="fw-bold mb-1">Create Account</h4>
                <p class="text-white-50 small mb-0">Join the Employee Management System</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-user"></i></span>
                            <input asp-for="FullName" class="form-control border-start-0" placeholder="e.g. Sarah Jenkins" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="sarah.jenkins@company.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-key"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" placeholder="Min. 6 chars, with upper &amp; digit" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-check-double"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Confirm password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-bold shadow-sm">
                        <i class="fas fa-user-check me-1"></i> Complete Registration
                    </button>
                </form>

                <div class="text-center small text-muted mt-4">
                    Already registered? <a asp-action="Login" class="text-success fw-semibold">Sign in here</a>
                </div>
            </div>
        </div>
    </div>
</div>
