<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management System</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Chart.js for Weekly working hours chart -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Style matching reference dashboard -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar matching image -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="d-flex align-items-center">
                    <div class="brand-icon-box">
                        <i class="fas fa-check"></i>
                    </div>
                    <span class="brand-title">EMS Portal</span>
                </div>
                <button class="collapse-toggle" id="sidebarCollapseBtn" type="button" onclick="toggleSidebar()" title="Collapse / Expand sidebar">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="fas fa-th-large"></i>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Employee" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")">
                    <i class="far fa-user"></i>
                    <span>Employees</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Department" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")">
                        <i class="fas fa-cube"></i>
                        <span>Departments</span>
                    </a>
                }
                <a asp-controller="Account" asp-action="Roles" class="nav-item-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")">
                    <i class="fas fa-user-shield"></i>
                    <span>Management</span>
                </a>
                <a asp-controller="Attendance" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")">
                    <i class="far fa-calendar-alt"></i>
                    <span>Attendance</span>
                </a>
                <a asp-controller="Holiday" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Holiday" ? "active" : "")">
                    <i class="fas fa-umbrella-beach"></i>
                    <span>Holidays</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="p-2 mb-2 bg-light rounded-3 d-flex align-items-center justify-content-between user-info-box">
                        <div class="d-flex align-items-center overflow-hidden">
                            <div class="brand-icon-box me-2" style="width: 28px; height: 28px; font-size: 0.8rem; background: #e0e7ff; color: #4338ca;">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-truncate sidebar-user-details">
                                <div class="small fw-bold text-dark text-truncate">@User.Identity.Name</div>
                                <small class="text-muted" style="font-size: 0.7rem;">
                                    @(User.IsInRole("Admin") ? "Administrator" : "Employee")
                                </small>
                            </div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline user-logout-btn">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2" title="Logout">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-1 mb-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-dark rounded-pill fw-bold">Sign In</a>
                    </div>
                }
                <!-- Settings Button - Opens Settings Modal -->
                <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#settingsModal" class="nav-item-link py-2" style="font-size: 0.85rem;">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-wrapper">
            <!-- Top Bar: Search Bar on Left, Portal Badge & Black/White Screen Theme Toggle on Right -->
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <div class="top-search-bar">
                    <i class="fas fa-search search-icon-pos"></i>
                    <form method="get" asp-controller="Employee" asp-action="Index">
                        <input type="text" name="search" value="@Context.Request.Query["search"]" class="search-input-pill" placeholder="Search employees, roles, departments..." />
                    </form>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-white text-dark shadow-sm border px-3 py-2 rounded-pill small fw-bold">
                        <i class="fas fa-circle text-success me-1" style="font-size: 0.5rem;"></i>
                        @(User.IsInRole("Admin") ? "Admin Portal" : "Employee Portal")
                    </span>

                    <!-- Dark / Light Mode Toggle Button matching provided icons & keyword -->
                    <button type="button" class="theme-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Toggle Dark / Light mode">
                        <i class="far fa-moon" id="themeIcon"></i>
                        <span id="themeLabel">Dark mode</span>
                    </button>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Settings Modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom py-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="brand-icon-box me-2" style="background-color: #f3f4f6; color: #111827;">
                            <i class="fas fa-sliders-h"></i>
                        </div>
                        <h5 class="modal-title fw-bold" id="settingsModalLabel">Application Settings</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Display & Screen Theme -->
                    <h6 class="fw-bold mb-3"><i class="fas fa-palette me-2 text-primary"></i>Appearance Mode</h6>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <label class="p-3 border rounded-3 w-100 d-block cursor-pointer" for="themeRadioLight" style="cursor: pointer;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="themeOptions" id="themeRadioLight" value="light" checked>
                                    <span class="form-check-label fw-bold">
                                        <i class="far fa-sun text-warning me-1"></i> Light mode
                                    </span>
                                </div>
                                <small class="text-muted d-block ps-4">Classic clean bright interface</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="p-3 border rounded-3 w-100 d-block cursor-pointer" for="themeRadioDark" style="cursor: pointer;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="themeOptions" id="themeRadioDark" value="dark">
                                    <span class="form-check-label fw-bold">
                                        <i class="far fa-moon me-1"></i> Dark mode
                                    </span>
                                </div>
                                <small class="text-muted d-block ps-4">Comfortable high-contrast dark</small>
                            </label>
                        </div>
                    </div>

                    <!-- User & Security Info -->
                    <h6 class="fw-bold mb-2"><i class="fas fa-shield-alt me-2 text-success"></i>Security &amp; Account Role</h6>
                    <div class="p-3 bg-light rounded-3 mb-4 small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Signed In User:</span>
                            <span class="fw-bold text-dark">@(User.Identity?.Name ?? "Guest User")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Access Level:</span>
                            <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-primary") rounded-pill px-2">
                                @(User.IsInRole("Admin") ? "Admin (Full Control)" : "Employee (Read Only)")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Database Engine:</span>
                            <span class="fw-semibold text-dark">SQL Server (EF Core Code-First)</span>
                        </div>
                    </div>

                    <!-- Quick Navigation -->
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Roles" class="btn btn-outline-dark btn-sm rounded-pill flex-grow-1" data-bs-dismiss="modal">
                            <i class="fas fa-user-shield me-1"></i> Manage Roles
                        </a>
                        <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary btn-sm rounded-pill" data-bs-dismiss="modal">
                            Privacy Policy
                        </a>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-dark btn-sm rounded-pill px-4" onclick="saveSettingsModal()">Save Changes</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Quick Monthly Attendance & Leave Preview Modal -->
    <div class="modal fade" id="globalAttendancePreviewModal" tabindex="-1" aria-labelledby="globalAttendancePreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 shadow-lg border-0">
                <div class="modal-header border-bottom py-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="brand-icon-box me-3" style="background-color: var(--accent-purple-light); color: var(--accent-purple); width: 40px; height: 40px; font-size: 1.1rem;">
                            <i class="far fa-calendar-check"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0" id="globalModalEmployeeName">Employee Attendance</h5>
                            <small class="text-muted" id="globalModalEmployeeSub">Monthly Attendance &amp; Leave Overview</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Summary Metrics for the Month -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <small class="text-muted fw-bold d-block text-uppercase">Days Present</small>
                                <span class="fs-4 fw-bold text-success" id="globalModalDaysPresent">0</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <small class="text-muted fw-bold d-block text-uppercase">Leaves Taken</small>
                                <span class="fs-4 fw-bold text-info" id="globalModalDaysLeave">0</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <small class="text-muted fw-bold d-block text-uppercase">Late Days</small>
                                <span class="fs-4 fw-bold text-warning" id="globalModalDaysLate">0</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <small class="text-muted fw-bold d-block text-uppercase">Available Leaves</small>
                                <span class="fs-4 fw-bold text-primary" id="globalModalLeaveBalance">18</span>
                            </div>
                        </div>
                    </div>

                    <!-- Daily Breakdown Table -->
                    <h6 class="fw-bold mb-2 text-dark"><i class="fas fa-list me-2 text-primary"></i>Attendance History for <span id="globalModalMonthHeader">This Month</span></h6>
                    <div class="table-responsive rounded-3 border" style="max-height: 280px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Clock In</th>
                                    <th>Clock Out</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="globalModalRecordsBody">
                                <tr><td colspan="6" class="text-center py-4 text-muted">Loading attendance data...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4 justify-content-between">
                    <a id="globalModalFullViewLink" href="#" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="fas fa-calendar-alt me-1"></i> Full Monthly Calendar
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS & jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
