@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }

<div class="text-center mt-5">
    <i class="fas fa-exclamation-triangle fa-5x text-warning"></i>
    <h2 class="mt-3">An error occurred</h2>
    <p class="text-muted">Something went wrong while processing your request.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
</div>
